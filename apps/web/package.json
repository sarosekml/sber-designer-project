{
  "name": "@sber-designer/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Editor web app — three modes (Interact / Design / Code), live-DOM canvas.",
  "scripts": {
    "dev": "bun run ../../scripts/write-build-info.ts && vite --host 127.0.0.1",
    "build": "bun run ../../scripts/write-build-info.ts && tsc -p tsconfig.json && vite build",
    "preview": "vite preview --port 5173 --host 127.0.0.1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.1.0",
    "@sber-designer/llm-gateway": "workspace:*",
    "@sber-designer/shared-types": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.456.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.5.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-tsconfig-paths": "^5.0.0"
  }
}
