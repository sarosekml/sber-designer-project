{
  "name": "@sber-ibp/uikit",
  "version": "14.74.0",
  "description": "DMB ui-kit",
  "license": "UNLICENSED",
  "main": "./build/index.js",
  "module": "./build/index.js",
  "types": "./build/index.d.ts",
  "source": "./src/index.ts",
  "engines": {
    "node": ">=16"
  },
  "repository": {
    "type": "git",
    "url": "https://stash.sigma.sbrf.ru/scm/pprbmer/ui-kit.git"
  },
  "publishConfig": {
    "registry": "https://nexus-ci.delta.sbrf.ru/repository/npm-dev/"
  },
  "scripts": {
    "setup": "npm install --ignore-scripts --legacy-peer-deps",
    "build": "cross-env NODE_ENV=production rollup -c",
    "build-dev": "cross-env NODE_ENV=development rollup -c",
    "start": "cross-env NODE_ENV=development rollup -c -w",
    "release": "standard-version",
    "test": "jest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint . --ext .tsx,.ts",
    "lint-and-fix": "eslint . --ext .tsx,.ts --fix",
    "prettier-format": "prettier --config .prettierrc.js \\\"src/**/*.tsx,.ts\\\" --write",
    "lint-staged": "lint-staged",
    "icons-generate": "cross-env TS_NODE_PROJECT=tsconfig.tools.json node --loader ts-node/esm --experimental-specifier-resolution=node ./tools/icon-converter/index.mts",
    "svgr": "svgr image-sources --out-dir src/assets/images --typescript",
    "release-fix": "standard-version --prerelease fix",
    "osc:check": "npx dependency-resolver",
    "osc:fix": "npx dependency-resolver -f",
    "clear-jest": "jest --clearCache"
  },
  "dependencies": {
    "@devexpress/dx-react-core": "4.0.9",
    "@devexpress/dx-react-grid": "4.0.9",
    "@devexpress/dx-react-grid-export": "4.0.9",
    "@devexpress/dx-react-grid-material-ui": "4.0.9",
    "@emotion/react": "11.10.5",
    "@emotion/styled": "11.10.5",
    "@mui/base": "5.0.0-alpha.125",
    "@mui/icons-material": "5.11.0",
    "@mui/lab": "5.0.0-alpha.120",
    "@mui/material": "5.11.9",
    "@mui/styles": "5.16.8",
    "@mui/system": "5.16.8",
    "@mui/x-date-pickers": "5.0.19",
    "bignumber.js": "9.1.2",
    "chart.js": "4.3.0",
    "chartjs-plugin-zoom": "2.0.1",
    "clsx": "1.1.1",
    "highlight.js": "11.10.0",
    "katex": "0.12.0",
    "marked": "13.0.2",
    "react-beautiful-dnd": "13.1.1",
    "react-chartjs-2": "5.2.0",
    "react-virtualized": "9.22.6",
    "yup": "0.32.11"
  },
  "devDependencies": {
    "@sber-ibp/core": "file:./vendor/sber-ibp-core",
    "@commitlint/cli": "17.1.2",
    "@commitlint/config-conventional": "16.2.1",
    "@hookform/resolvers": "2.8.8",
    "@rollup/plugin-node-resolve": "16.0.3",
    "@rollup/plugin-url": "8.0.2",
    "@storybook/addon-essentials": "8.0.10",
    "@storybook/addon-links": "8.0.10",
    "@storybook/addon-webpack5-compiler-swc": "1.0.4",
    "@storybook/blocks": "8.0.10",
    "@storybook/manager-api": "8.0.10",
    "@storybook/preview-api": "8.0.10",
    "@storybook/react": "8.0.10",
    "@storybook/react-webpack5": "8.0.10",
    "@storybook/test": "8.0.10",
    "@svgr/cli": "6.5.1",
    "@svgr/webpack": "6.5.1",
    "@types/big.js": "6.2.2",
    "@types/jest": "29.4.0",
    "@types/jscodeshift": "17.3.0",
    "@types/katex": "0.16.7",
    "@types/react": "18.3.16",
    "@types/react-beautiful-dnd": "13.1.8",
    "@typescript-eslint/eslint-plugin": "5.26.0",
    "@typescript-eslint/parser": "5.26.0",
    "cross-env": "7.0.3",
    "date-fns": "2.30.0",
    "eslint": "8.44.0",
    "eslint-config-prettier": "8.8.0",
    "eslint-plugin-cypress": "2.13.3",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-sonarjs": "0.19.0",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-typescript-sort-keys": "2.3.0",
    "glob": "11.0.3",
    "husky": "8.0.0",
    "inquirer": "12.9.4",
    "jest": "29.4.3",
    "jest-environment-jsdom": "29.4.3",
    "jscodeshift": "17.3.0",
    "lint-staged": "12.3.5",
    "prettier": "2.8.8",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-error-boundary": "3.1.4",
    "react-hook-form": "7.33.0",
    "rollup": "4.44.2",
    "rollup-plugin-cleaner": "1.0.0",
    "rollup-plugin-typescript2": "0.36.0",
    "standard-version": "9.5.0",
    "storybook": "8.0.10",
    "storycap": "5.0.0",
    "ts-jest": "29.0.5",
    "ts-node": "10.9.2",
    "ts-patch": "3.3.0",
    "typescript": "5.1.6",
    "typescript-transform-paths": "3.4.6"
  },
  "peerDependencies": {
    "date-fns": "^2.28.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^3.1.4",
    "react-hook-form": "^7.33.0"
  },
  "overrides": {
    "body-parser": "1.20.3",
    "tar": "7.5.16"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "files": [
    "build"
  ]
}