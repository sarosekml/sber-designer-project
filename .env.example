# sber-designer local MVP environment
#
# Copy values into your shell, .env, or service-specific launcher when the
# default local setup is not enough. Do not put real provider keys here.

# ----- Root dev runner -------------------------------------------------------
# `bun run dev` starts api, sandbox, and web together. The runner probes ports
# from these defaults and passes the resolved URLs to child services.
# PORT=3000
# SBER_DESIGNER_SANDBOX_URL=http://localhost:3001
# VITE_API_URL=http://localhost:3000

# Local MVP smoke checklist/probes.
# SBER_DESIGNER_SMOKE_WEB_URL=http://localhost:5173
# SBER_DESIGNER_SMOKE_API_URL=http://localhost:3000
# SBER_DESIGNER_SMOKE_CHECK_ENDPOINTS=1
# SBER_DESIGNER_SMOKE_USER=local-smoke

# ----- API project/config paths ---------------------------------------------
# By default the API reads `sber-designer.json` from this repository and opens
# the active connected project from its normal local registry. Use these only
# for deterministic local smoke runs or custom developer machines.
# SBER_DESIGNER_CONFIG_PATH=/absolute/path/to/sber-designer.json
# SBER_DESIGNER_PROJECT_PATH=/absolute/path/to/project/.sber-designer/project.sdproj
# SBER_DESIGNER_PROJECTS_REGISTRY_PATH=/absolute/path/to/local-projects-registry.json
# SBER_DESIGNER_PROJECT_THUMBNAILS_DIR=/absolute/path/to/local-project-thumbnails
# Explicit runtime boundary. `bun run dev` forces local; `bun run dev:server`
# forces server and requires the server roots below.
# SBER_DESIGNER_DEPLOYMENT_MODE=local
# Server/password mode: each identity is confined to <root>/<userId>/ and gets
# projects.json, settings.json, and thumbnails under the users root.
# SBER_DESIGNER_PROJECTS_ROOT=/srv/sber-designer/projects
# SBER_DESIGNER_USERS_ROOT=/home/sd/.sber-designer/users

# Extra filesystem roots that the API may read from in local file-picker and
# asset import flows. Colon-separated on macOS/Linux.
# SBER_DESIGNER_FS_ROOTS=/Users/me/projects:/Users/me/assets

# ----- Auth -----------------------------------------------------------------
# Empty OIDC settings keep the local stub auth mode. Stub mode expects requests
# from the editor to carry `x-sber-designer-user`.
# SBER_DESIGNER_OIDC_ISSUER=
# SBER_DESIGNER_OIDC_AUDIENCE=
# SBER_DESIGNER_OIDC_JWKS_URL=

# ----- Sandbox ---------------------------------------------------------------
# Local spawn is the current MVP default. Docker mode exists for experiments
# and future protected/on-prem deployments; it is not required for local MVP.
# SBER_DESIGNER_SANDBOX_DRIVER=local
# SBER_DESIGNER_SANDBOX_IMAGE=sd-sandbox:latest
# Maximum live dev-server sessions. Local default is unlimited; server default
# is 5. An explicit value applies to either profile; 0 disables new sessions.
# SBER_DESIGNER_SANDBOX_MAX_SESSIONS=5
# Delete completed .sber-designer/runs/<run-id> artifacts older than N days.
# Empty, 0, false, or off disables cleanup. Server deploy/env.example enables 30.
# SBER_DESIGNER_RUNS_RETENTION_DAYS=30
# SBER_DESIGNER_BUN_PATH=bun

# Connected project dev-servers inherit the developer shell in local mode today.
# Keep package-manager infrastructure variables in the shell when needed:
# HTTP_PROXY=http://proxy.internal:8080
# HTTPS_PROXY=http://proxy.internal:8080
# NO_PROXY=localhost,127.0.0.1,.internal
# NODE_EXTRA_CA_CERTS=/absolute/path/to/internal-ca.pem
# SSL_CERT_FILE=/absolute/path/to/internal-ca.pem
#
# Prefer project-owned registry config where possible: `.npmrc`, `.bunfig.toml`,
# lockfiles, and documented install commands in the connected project.

# ----- Agent runtimes and diagnostics ---------------------------------------
# Optional paths for local CLI runtimes. Leave unset to use normal PATH lookup.
# SBER_DESIGNER_CODEX_BIN=/absolute/path/to/codex
# SBER_DESIGNER_OPENCODE_BIN=/absolute/path/to/opencode
# SBER_DESIGNER_CLAUDE_CODE_BIN=/absolute/path/to/claude
# SBER_DESIGNER_KIMI_BIN=/absolute/path/to/kimi
# SBER_DESIGNER_GIGACODE_BIN=/absolute/path/to/gigacode
# Direct path to GigaCode state (normally ~/.gigacode). The API reads only
# gigacode_token.json and settings.json; it never reads protected storage.
# SBER_DESIGNER_GIGACODE_HOME=/absolute/path/to/.gigacode
# SBER_DESIGNER_AGENT_RUNTIMES_PATH=/absolute/path/to/agent-runtimes.json

# Attempt logs are local machine diagnostics, not project-owned state.
# SBER_DESIGNER_AGENT_DEV_LOG=1
# SBER_DESIGNER_AGENT_LOG_DIR=/absolute/path/to/local/temp/sber-designer-agent-runs

# Disable product agent scripts in local debugging, or allow only specific
# script ids from the internal product agent kit.
# SBER_DESIGNER_AGENT_SCRIPTS=disabled
# SBER_DESIGNER_AGENT_SCRIPT_ALLOWLIST=
# SBER_DESIGNER_USER_KIT=enabled

# ----- Browser/render evidence ----------------------------------------------
# Optional Chrome DevTools endpoint for screenshot/render evidence capture.
# SBER_DESIGNER_CHROME_DEBUGGING_URL=http://127.0.0.1:9222
# SBER_DESIGNER_VISUAL_EVIDENCE=1

# ----- proj-mcp --------------------------------------------------------------
# Used when running `@sber-designer/proj-mcp` outside the API process.
# SBER_DESIGNER_API_URL=http://localhost:3000
# SBER_DESIGNER_MCP_TOKEN=

# ----- Local env loading -----------------------------------------------------
# services/api loads local env files unless this is set.
# SBER_DESIGNER_DISABLE_LOCAL_ENV_LOAD=1

# ----- Provider secrets ------------------------------------------------------
# Put real provider keys only in your private environment. API providers resolve
# `{env:NAME}` references from `sber-designer.json`; never commit those values.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
