# sber-designer closed beta server environment.
# Copy to /etc/sber-designer/env and keep it out of git.

# Core service topology.
PORT=3000
SBER_DESIGNER_DEPLOYMENT_MODE=server
SBER_DESIGNER_PUBLIC_URL=https://sd-beta.example.internal
SBER_DESIGNER_SANDBOX_URL=http://127.0.0.1:3001
SBER_DESIGNER_CONFIG_PATH=/etc/sber-designer/sber-designer.json
SBER_DESIGNER_DISABLE_LOCAL_ENV_LOAD=1

# Built-in accounts.
SBER_DESIGNER_AUTH_MODE=password
SBER_DESIGNER_BOOTSTRAP_ADMIN_EMAIL=owner@example.internal
SBER_DESIGNER_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-temporary-password
SBER_DESIGNER_TRUST_PROXY=1
SBER_DESIGNER_CAPTCHA=always
SBER_DESIGNER_SERVICE_TOKENS=smoke:replace-with-64-hex,mcp:replace-with-64-hex
# SBER_DESIGNER_ADMIN_EMAILS=owner@example.internal,backup-admin@example.internal
# SBER_DESIGNER_ALLOWED_ORIGINS=

# Server-side workspace and user data roots. Keep these outside /opt/sber-designer.
SBER_DESIGNER_PROJECTS_ROOT=/srv/sber-designer/projects
SBER_DESIGNER_USERS_ROOT=/home/sd/.sber-designer/users

# Legacy Stage-0 migration only. Leave unset on clean servers.
# SBER_DESIGNER_PROJECTS_REGISTRY_PATH=/home/sd/.sber-designer/projects.json
# SBER_DESIGNER_PROJECT_THUMBNAILS_DIR=/home/sd/.sber-designer/thumbnails

# Sandbox capacity and disk hygiene.
SBER_DESIGNER_SANDBOX_MAX_SESSIONS=5
SBER_DESIGNER_RUNS_RETENTION_DAYS=30
# SBER_DESIGNER_SANDBOX_DRIVER=docker
# SBER_DESIGNER_SANDBOX_IMAGE=sd-sandbox:latest
SBER_DESIGNER_BUN_PATH=/home/sd/.bun/bin/bun

# Smoke/update helpers.
SBER_DESIGNER_SMOKE_WEB_URL=https://sd-beta.example.internal
SBER_DESIGNER_SMOKE_API_URL=https://sd-beta.example.internal
SBER_DESIGNER_SMOKE_CHECK_ENDPOINTS=1
# Optional explicit smoke token; otherwise deploy/update.sh reads smoke:<token>
# from SBER_DESIGNER_SERVICE_TOKENS.
# SBER_DESIGNER_SMOKE_SERVICE_TOKEN=replace-with-64-hex

# Optional server-side CLI runtimes. User laptop CLIs are not visible remotely.
# SBER_DESIGNER_CODEX_BIN=/usr/local/bin/codex
# SBER_DESIGNER_OPENCODE_BIN=/usr/local/bin/opencode
# SBER_DESIGNER_CLAUDE_CODE_BIN=/usr/local/bin/claude
# SBER_DESIGNER_AGENT_RUNTIMES_PATH=/etc/sber-designer/agent-runtimes.json
# SBER_DESIGNER_AGENT_SCRIPTS=disabled
# SBER_DESIGNER_AGENT_SCRIPT_ALLOWLIST=
# SBER_DESIGNER_USER_KIT=enabled

# Optional render evidence.
# SBER_DESIGNER_CHROME_DEBUGGING_URL=http://127.0.0.1:9222
# SBER_DESIGNER_VISUAL_EVIDENCE=1

# Optional proj-mcp bridge.
SBER_DESIGNER_API_URL=http://127.0.0.1:3000
# SBER_DESIGNER_MCP_TOKEN=replace-with-private-token

# Provider secrets referenced from /etc/sber-designer/sber-designer.json.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
